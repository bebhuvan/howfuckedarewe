---
/**
 * Page Table of Contents
 *
 * Floating dot navigation on right side (desktop only).
 * Shows current section, allows jumping between sections.
 *
 * Because you need a map through the hellscape.
 */

interface Section {
  id: string;
  label: string;
}

interface Props {
  sections: Section[];
}

const { sections } = Astro.props;
---

<nav class="page-toc" id="page-toc" aria-label="Page sections">
  <div class="toc-dots">
    {sections.map((section, index) => (
      <a
        href={`#${section.id}`}
        class="toc-dot"
        data-section={section.id}
        aria-label={section.label}
        title={section.label}
      >
        <span class="dot"></span>
        <span class="dot-label">{section.label}</span>
      </a>
    ))}
  </div>
</nav>

<script>
  const toc = document.getElementById("page-toc");
  const dots = toc?.querySelectorAll(".toc-dot");

  if (toc && dots && dots.length > 0) {
    // Get all sections
    const sections = Array.from(dots).map((dot) => ({
      id: (dot as HTMLElement).dataset.section || "",
      element: document.getElementById(
        (dot as HTMLElement).dataset.section || ""
      ),
      dot: dot as HTMLElement,
    }));

    // Update active section on scroll
    const updateActive = () => {
      const scrollPos = window.scrollY + window.innerHeight / 3;

      let activeSection: string | null = null;

      sections.forEach(({ id, element }) => {
        if (element) {
          const rect = element.getBoundingClientRect();
          const top = rect.top + window.scrollY;
          const bottom = top + rect.height;

          if (scrollPos >= top && scrollPos < bottom) {
            activeSection = id;
          }
        }
      });

      // Update dot states
      sections.forEach(({ id, dot }) => {
        dot.classList.toggle("active", id === activeSection);
      });
    };

    window.addEventListener("scroll", updateActive, { passive: true });
    updateActive();

    // Smooth scroll to section on click
    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        e.preventDefault();
        const sectionId = (dot as HTMLElement).dataset.section;
        const section = document.getElementById(sectionId || "");
        if (section) {
          section.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      });
    });

    // Show/hide TOC based on scroll position
    const updateVisibility = () => {
      const scrolled = window.scrollY > 300;
      toc.classList.toggle("visible", scrolled);
    };

    window.addEventListener("scroll", updateVisibility, { passive: true });
    updateVisibility();
  }
</script>

<style>
  .page-toc {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 90;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .page-toc.visible {
    opacity: 1;
    visibility: visible;
  }

  .toc-dots {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-radius: 100px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  .toc-dot {
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d4d4d4;
    transition: all 0.2s ease;
  }

  .toc-dot:hover .dot,
  .toc-dot.active .dot {
    background: #991b1b;
    transform: scale(1.2);
  }

  .toc-dot.active .dot {
    box-shadow: 0 0 0 3px rgba(153, 27, 27, 0.2);
  }

  .dot-label {
    position: absolute;
    right: calc(100% + 0.75rem);
    font-size: 0.75rem;
    font-weight: 500;
    color: #525252;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.2s ease;
    pointer-events: none;
    background: rgba(255, 255, 255, 0.95);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .toc-dot:hover .dot-label {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hide on mobile and tablet */
  @media (max-width: 1100px) {
    .page-toc {
      display: none;
    }
  }
</style>
