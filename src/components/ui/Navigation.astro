---
/**
 * Navigation Component — REFINED V2
 *
 * Mobile-first responsive navigation with refined styling.
 * Premium feel with smooth transitions.
 */
import { ALL_CITIES } from '../../lib/cities';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

const currentPath = Astro.url.pathname;
const isLeaderboard = currentPath === '/leaderboard';
const isWhatNow = currentPath === '/what-now';
const isData = currentPath === '/data';
const isMethodology = currentPath === '/methodology';
const isMarketplace = currentPath === '/marketplace';
const isStatus = currentPath === '/status';
const isHome = !currentSlug && !isLeaderboard && !isWhatNow && !isData && !isMethodology && !isMarketplace && !isStatus;

// Get current city name for mobile display
const currentCityName = currentSlug
  ? ALL_CITIES.find(c => c.slug === currentSlug)?.name || currentSlug
  : 'All India';
---

<nav class="site-nav">
  <div class="nav-main">
    <a href="/" class="brand">
      how <strong>fucked</strong> are we<span class="brand-q">?</span>
    </a>

    <!-- Mobile controls -->
    <div class="mobile-controls">
      <span class="current-location">{currentCityName}</span>
      <button class="menu-btn" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <!-- Desktop nav links -->
    <div class="nav-links">
      <a href="/leaderboard" class:list={[{ active: isLeaderboard }]}>Leaderboard</a>
      <a href="/marketplace" class:list={['special', { active: isMarketplace }]}>Lung Exchange</a>
      <a href="/data" class:list={[{ active: isData }]}>Data</a>
      <a href="/what-now" class:list={[{ active: isWhatNow }]}>What Now</a>
    </div>
  </div>

  <!-- City pills row -->
  <div class="cities-wrapper">
    <div class="scroll-fade fade-left" aria-hidden="true"></div>
    <div class="cities-scroll" id="nav-cities">
      <a href="/" class:list={['city-pill', { active: isHome }]}>All India</a>
      {ALL_CITIES.map((city) => (
        <a href={`/${city.slug}`} class:list={['city-pill', { active: currentSlug === city.slug }]}>
          {city.name}
        </a>
      ))}
    </div>
    <div class="scroll-fade fade-right" aria-hidden="true"></div>
  </div>

  <!-- Mobile dropdown -->
  <div class="mobile-menu" aria-hidden="true">
    <div class="menu-section">
      <span class="menu-label">Cities</span>
      <div class="cities-grid">
        <a href="/" class:list={['grid-city', { active: isHome }]}>All India</a>
        {ALL_CITIES.map((city) => (
          <a href={`/${city.slug}`} class:list={['grid-city', { active: currentSlug === city.slug }]}>
            {city.name}
          </a>
        ))}
      </div>
    </div>
    <div class="menu-divider"></div>
    <div class="menu-links">
      <a href="/leaderboard" class:list={[{ active: isLeaderboard }]}>Fucked Leaderboard</a>
      <a href="/marketplace" class:list={['special', { active: isMarketplace }]}>The Lung Exchange™</a>
      <a href="/data" class:list={[{ active: isData }]}>Data & Research</a>
      <a href="/what-now" class:list={[{ active: isWhatNow }]}>What Now?</a>
      <a href="/methodology" class:list={[{ active: isMethodology }]}>Methodology</a>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const menuBtn = document.querySelector('.menu-btn');
  const mobileMenu = document.querySelector('.mobile-menu');
  const nav = document.querySelector('.site-nav');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.setAttribute('aria-hidden', String(isExpanded));
      nav?.classList.toggle('menu-open');
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!nav?.contains(e.target as Node)) {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
        nav?.classList.remove('menu-open');
      }
    });

    // Close menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menuBtn.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
        nav?.classList.remove('menu-open');
      });
    });
  }

  // City pills scroll fade indicator
  const citiesScroll = document.getElementById('nav-cities');
  const wrapper = citiesScroll?.parentElement;

  if (citiesScroll && wrapper) {
    const updateScrollFades = () => {
      const { scrollLeft, scrollWidth, clientWidth } = citiesScroll;
      const atStart = scrollLeft <= 10;
      const atEnd = scrollLeft >= scrollWidth - clientWidth - 10;

      wrapper.classList.toggle('at-start', atStart);
      wrapper.classList.toggle('at-end', atEnd);
    };

    citiesScroll.addEventListener('scroll', updateScrollFades, { passive: true });
    updateScrollFades();
    window.addEventListener('resize', updateScrollFades, { passive: true });
  }
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(248, 247, 246, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border, #e2e0dd);
  }

  .nav-main {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Brand */
  .brand {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-h4, 1.25rem);
    font-weight: 400;
    color: var(--text, #1a1a1a);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: opacity var(--duration-fast, 150ms) ease;
  }

  .brand:hover {
    text-decoration: none;
    opacity: 0.8;
  }

  .brand strong {
    font-weight: 600;
  }

  .brand-q {
    font-weight: 600;
    color: var(--accent, #b91c1c);
    font-size: 1.15em;
  }

  /* Mobile controls */
  .mobile-controls {
    display: none;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }

  .current-location {
    font-size: var(--text-caption, 0.6875rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: white;
    background: var(--text, #1a1a1a);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border-radius: var(--radius-sm, 6px);
  }

  .menu-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    border-radius: var(--radius-sm, 6px);
    transition: background var(--duration-fast, 150ms) ease;
  }

  .menu-btn:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 20px;
  }

  .hamburger span {
    display: block;
    height: 2px;
    background: var(--text, #1a1a1a);
    border-radius: 1px;
    transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hamburger span:nth-child(1) { width: 100%; }
  .hamburger span:nth-child(2) { width: 70%; }
  .hamburger span:nth-child(3) { width: 100%; }

  /* Hamburger animation */
  .menu-open .hamburger span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .menu-open .hamburger span:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .menu-open .hamburger span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Desktop nav links */
  .nav-links {
    display: flex;
    gap: var(--space-1, 0.25rem);
  }

  .nav-links a {
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    font-size: var(--text-xs, 0.8125rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted, #6b6b6b);
    text-decoration: none;
    border-radius: var(--radius-sm, 6px);
    transition:
      color var(--duration-fast, 150ms) ease,
      background var(--duration-fast, 150ms) ease;
  }

  .nav-links a:hover {
    color: var(--text, #1a1a1a);
    background: rgba(0, 0, 0, 0.03);
  }

  .nav-links a.active {
    color: var(--accent, #b91c1c);
  }

  /* Cities row */
  .cities-wrapper {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }

  .scroll-fade {
    position: absolute;
    top: 0;
    bottom: var(--space-3, 0.75rem);
    width: 48px;
    pointer-events: none;
    z-index: 2;
    transition: opacity var(--duration-fast, 150ms) ease;
  }

  .fade-left {
    left: 0;
    background: linear-gradient(to right, rgba(248, 247, 246, 1) 0%, rgba(248, 247, 246, 0) 100%);
  }

  .fade-right {
    right: 0;
    background: linear-gradient(to left, rgba(248, 247, 246, 1) 0%, rgba(248, 247, 246, 0) 100%);
  }

  .cities-wrapper.at-start .fade-left {
    opacity: 0;
  }

  .cities-wrapper.at-end .fade-right {
    opacity: 0;
  }

  .cities-scroll {
    padding: 0 var(--space-5, 1.25rem) var(--space-3, 0.75rem);
    display: flex;
    gap: var(--space-1, 0.25rem);
    overflow-x: auto;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .cities-scroll::-webkit-scrollbar {
    display: none;
  }

  .city-pill {
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    font-size: var(--text-sm, 0.9375rem);
    font-weight: 500;
    color: var(--text-secondary, #4a4a4a);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-sm, 6px);
    transition:
      color var(--duration-fast, 150ms) ease,
      background var(--duration-fast, 150ms) ease;
  }

  .city-pill:hover {
    background: rgba(0, 0, 0, 0.04);
    color: var(--text, #1a1a1a);
  }

  .city-pill.active {
    background: var(--text, #1a1a1a);
    color: white;
  }

  /* Mobile menu */
  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(248, 247, 246, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border, #e2e0dd);
    padding: var(--space-5, 1.25rem);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
    max-height: 75vh;
    overflow-y: auto;
  }

  .mobile-menu[aria-hidden="false"] {
    display: block;
    animation: slideIn 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-section {
    margin-bottom: var(--space-4, 1rem);
  }

  .menu-label {
    display: block;
    font-size: var(--text-micro, 0.625rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-subtle, #8a8a8a);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .cities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2, 0.5rem);
  }

  .grid-city {
    display: block;
    padding: var(--space-3, 0.75rem) var(--space-2, 0.5rem);
    font-size: var(--text-xs, 0.8125rem);
    font-weight: 500;
    color: var(--text-secondary, #4a4a4a);
    text-decoration: none;
    text-align: center;
    border-radius: var(--radius-sm, 6px);
    background: rgba(0, 0, 0, 0.02);
    transition: all var(--duration-fast, 150ms) ease;
  }

  .grid-city:hover,
  .grid-city:active {
    background: rgba(0, 0, 0, 0.05);
    color: var(--text, #1a1a1a);
  }

  .grid-city.active {
    background: var(--text, #1a1a1a);
    color: white;
  }

  .menu-divider {
    height: 1px;
    background: var(--border, #e2e0dd);
    margin: var(--space-4, 1rem) 0;
  }

  .menu-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
  }

  .menu-links a {
    display: block;
    padding: var(--space-3, 0.75rem) var(--space-2, 0.5rem);
    font-size: var(--text-base, 1rem);
    font-weight: 500;
    color: var(--text-secondary, #4a4a4a);
    text-decoration: none;
    border-radius: var(--radius-sm, 6px);
    transition: all var(--duration-fast, 150ms) ease;
  }

  .menu-links a:hover,
  .menu-links a:active {
    background: rgba(0, 0, 0, 0.03);
    color: var(--text, #1a1a1a);
  }

  .menu-links a.active {
    color: var(--accent, #b91c1c);
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════ */

  @media (max-width: 720px) {
    .nav-main {
      padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    }

    .brand {
      font-size: var(--text-base, 1rem);
    }

    /* Show mobile controls, hide desktop nav */
    .mobile-controls {
      display: flex;
    }

    .nav-links {
      display: none;
    }

    /* Hide city row on mobile */
    .cities-scroll {
      display: none;
    }

    .scroll-fade {
      display: none;
    }
  }

  /* Tablet */
  @media (min-width: 721px) and (max-width: 920px) {
    .cities-scroll {
      padding: 0 var(--space-4, 1rem) var(--space-3, 0.75rem);
    }

    .city-pill {
      padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
      font-size: var(--text-xs, 0.8125rem);
    }
  }
</style>
