---
/**
 * Forecast Chart Component
 *
 * 7-day PM2.5 forecast visualization with Tomorrow's Outlook.
 */
import type { ForecastDay } from "../../lib/types";

interface Props {
  forecast: ForecastDay[];
  currentPm25?: number | null;
}

const { forecast, currentPm25 } = Astro.props;

if (forecast.length === 0) {
  return null;
}

// Calculate scale
const maxFuckedIndex = Math.max(
  ...forecast.map((d) => d.metrics.fuckedIndex),
  5,
);
const chartHeight = 120;
const chartWidth = 100; // Percentage based

function getBarHeight(fuckedIndex: number): number {
  return (fuckedIndex / maxFuckedIndex) * chartHeight;
}

// Generate sparkline path for trend visualization
function generateSparklinePath(): string {
  if (forecast.length < 2) return '';

  const points = forecast.map((day, i) => {
    const x = (i / (forecast.length - 1)) * 100;
    const y = 100 - (day.metrics.fuckedIndex / maxFuckedIndex) * 100;
    return `${x},${y}`;
  });

  return `M ${points.join(' L ')}`;
}

function getBarColor(fuckedIndex: number): string {
  if (fuckedIndex < 0.5) return "#6b8e6b";
  if (fuckedIndex < 2) return "#a3a322";
  if (fuckedIndex < 5) return "#c45a20";
  return "#b91c1c";
}

// Tomorrow's Outlook - compare today vs tomorrow
const today = forecast[0];
const tomorrow = forecast[1];
let tomorrowOutlook: {
  isBetter: boolean;
  diff: number;
  message: string;
} | null = null;

if (today && tomorrow && currentPm25) {
  const diff = tomorrow.pm25Concentration - currentPm25;
  const isBetter = diff < -5; // At least 5 µg/m³ improvement
  const isWorse = diff > 5; // At least 5 µg/m³ worse

  if (isBetter) {
    tomorrowOutlook = {
      isBetter: true,
      diff: Math.abs(diff),
      message: `Tomorrow looks better (−${Math.abs(diff).toFixed(0)} µg/m³). Plan outdoor activities.`,
    };
  } else if (isWorse) {
    tomorrowOutlook = {
      isBetter: false,
      diff: Math.abs(diff),
      message: `Tomorrow will be worse (+${Math.abs(diff).toFixed(0)} µg/m³). Consider staying indoors.`,
    };
  }
}
---

<section class="forecast-section">
  <h2>7-Day Forecast</h2>

  {
    tomorrowOutlook && (
      <div
        class:list={[
          "tomorrow-outlook",
          {
            better: tomorrowOutlook.isBetter,
            worse: !tomorrowOutlook.isBetter,
          },
        ]}
      >
        <span class="outlook-icon">
          {tomorrowOutlook.isBetter ? "📈" : "📉"}
        </span>
        <span class="outlook-message">{tomorrowOutlook.message}</span>
      </div>
    )
  }

  <div class="forecast-chart">
    <!-- Sparkline trend overlay -->
    {forecast.length >= 2 && (
      <div class="sparkline-container" aria-hidden="true">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="sparkline-svg">
          <path
            d={generateSparklinePath()}
            fill="none"
            stroke="#991b1b"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="sparkline-path"
          />
          <!-- Gradient fill under the line -->
          <defs>
            <linearGradient id="sparkline-gradient" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0%" stop-color="rgba(153, 27, 27, 0.2)" />
              <stop offset="100%" stop-color="rgba(153, 27, 27, 0)" />
            </linearGradient>
          </defs>
          <path
            d={`${generateSparklinePath()} L 100,100 L 0,100 Z`}
            fill="url(#sparkline-gradient)"
            class="sparkline-fill"
          />
        </svg>
      </div>
    )}

    <div class="chart-bars">
      {
        forecast.map((day, index) => (
          <div class="bar-container">
            <div class="bar-value">{day.metrics.fuckedIndex.toFixed(1)}</div>
            <div
              class="bar"
              style={`height: ${getBarHeight(day.metrics.fuckedIndex)}px; background: ${getBarColor(day.metrics.fuckedIndex)}`}
            >
              <div class="bar-tooltip">
                <>
                  <strong>{day.dateLabel}</strong>
                  <br />
                </>
                PM2.5: {day.pm25Concentration.toFixed(1)} µg/m³
                <br />
                {day.metrics.cigarettesPerDay.toFixed(1)} cigs/day
              </div>
            </div>
            <div class="bar-label">
              <span class="day">{day.dayLabel}</span>
              <span class="date">{day.dateLabel.split(" ")[0]}</span>
            </div>
            {index === 0 && <div class="today-indicator">Today</div>}
          </div>
        ))
      }
    </div>

    <div class="chart-legend">
      <div class="legend-item">
        <span class="legend-color" style="background: #6b8e6b"></span>
        <span>&lt;0.5 Fine*</span>
      </div>
      <div class="legend-item">
        <span class="legend-color" style="background: #a3a322"></span>
        <span>0.5-2 Cope</span>
      </div>
      <div class="legend-item">
        <span class="legend-color" style="background: #c45a20"></span>
        <span>2-5 Denial</span>
      </div>
      <div class="legend-item">
        <span class="legend-color" style="background: #b91c1c"></span>
        <span>&gt;5 LOL</span>
      </div>
    </div>
  </div>

  <p class="forecast-note">
    Forecast based on WAQI predictions. Actual conditions may vary.
  </p>
</section>

<style>
  .forecast-section {
    margin-bottom: 2rem;
  }

  h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .forecast-chart {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 1.5rem;
    position: relative;
  }

  /* Sparkline overlay */
  .sparkline-container {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    right: 1.5rem;
    bottom: calc(40px + 3rem + 1rem); /* Account for labels and legend */
    pointer-events: none;
    z-index: 1;
  }

  .sparkline-svg {
    width: 100%;
    height: 100%;
  }

  .sparkline-path {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: drawLine 1.5s ease-out forwards 0.5s;
  }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  .sparkline-fill {
    opacity: 0;
    animation: fadeIn 0.5s ease-out forwards 1.5s;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .chart-bars {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    height: 180px;
    padding-bottom: 40px;
    position: relative;
    z-index: 2;
  }

  .bar-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    max-width: 60px;
  }

  .bar-value {
    font-size: 0.75rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 0.25rem;
  }

  .bar {
    width: 70%;
    max-width: 40px;
    border-radius: 4px 4px 0 0;
    position: relative;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .bar:hover {
    transform: scaleY(1.05);
  }

  .bar-tooltip {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #1a1a1a;
    color: white;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    font-size: 0.75rem;
    white-space: nowrap;
    z-index: 10;
    margin-bottom: 8px;
  }

  .bar:hover .bar-tooltip {
    display: block;
  }

  .bar-label {
    position: absolute;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: translateY(100%);
    padding-top: 0.5rem;
  }

  .day {
    font-size: 0.75rem;
    font-weight: 600;
    color: #333;
  }

  .date {
    font-size: 0.625rem;
    color: #999;
  }

  .today-indicator {
    position: absolute;
    bottom: -35px;
    font-size: 0.625rem;
    font-weight: 600;
    color: #b91c1c;
    text-transform: uppercase;
  }

  .chart-legend {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6875rem;
    color: #666;
  }

  .legend-color {
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }

  .forecast-note {
    font-size: 0.75rem;
    color: #999;
    text-align: center;
    margin-top: 0.75rem;
    font-style: italic;
  }

  @media (max-width: 600px) {
    .chart-legend {
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .bar-value {
      font-size: 0.625rem;
    }
  }

  /* Tomorrow's Outlook styles */
  .tomorrow-outlook {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 1rem;
    font-size: 0.9375rem;
  }

  .tomorrow-outlook.better {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .tomorrow-outlook.worse {
    background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .outlook-icon {
    font-size: 1.25rem;
  }

  .outlook-message {
    flex: 1;
    font-weight: 500;
  }
</style>
