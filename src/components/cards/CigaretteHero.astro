---
/**
 * Cigarette Hero — V9 with illustration
 *
 * Jarring visual + clear data.
 */
import type { AirQualityMetrics } from '../../lib/types';

interface Props {
  metrics: AirQualityMetrics;
  cityName: string;
  pm25: number;
}

const { metrics, cityName, pm25 } = Astro.props;
const cigarettes = metrics.cigarettesPerDay;
---

<section class="hero">
  <header class="hero-header">
    <span class="live-badge">Live</span>
    <h1 class="city-name">{cityName}</h1>
  </header>

  <!-- Cigarette illustration -->
  <div class="cigarette-visual">
    <svg class="cigarette" viewBox="0 0 200 40" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Filter (white part) -->
      <rect x="0" y="10" width="40" height="20" rx="2" fill="#d4a574"/>
      <rect x="2" y="12" width="36" height="16" rx="1" fill="#e8c9a0"/>
      <!-- Paper (cigarette body) -->
      <rect x="40" y="10" width="140" height="20" rx="1" fill="#f5f5f0"/>
      <rect x="40" y="10" width="140" height="20" rx="1" fill="url(#paper-texture)" opacity="0.3"/>
      <!-- Burning tip -->
      <rect x="175" y="10" width="25" height="20" rx="1" fill="#1a1a1a"/>
      <rect x="180" y="12" width="15" height="16" fill="#ff4500"/>
      <rect x="185" y="14" width="8" height="12" fill="#ff6b35"/>
      <rect x="188" y="16" width="4" height="8" fill="#ffaa00"/>
      <!-- Ember glow -->
      <circle cx="190" cy="20" r="12" fill="#ff4500" opacity="0.3"/>
      <!-- Ash -->
      <rect x="195" y="12" width="5" height="16" rx="1" fill="#4a4a4a"/>
      <defs>
        <pattern id="paper-texture" patternUnits="userSpaceOnUse" width="4" height="4">
          <rect width="4" height="4" fill="#f0f0e8"/>
          <rect x="0" y="0" width="1" height="1" fill="#e8e8e0"/>
          <rect x="2" y="2" width="1" height="1" fill="#e8e8e0"/>
        </pattern>
      </defs>
    </svg>
    <!-- Smoke wisps -->
    <div class="smoke">
      <div class="smoke-wisp wisp-1"></div>
      <div class="smoke-wisp wisp-2"></div>
      <div class="smoke-wisp wisp-3"></div>
    </div>
  </div>

  <div class="main-message">
    <p class="intro">Breathing {cityName}'s air today is equivalent to smoking</p>
    <div class="cigarette-count">
      <span class="count">{cigarettes.toFixed(1)}</span>
      <span class="unit">cigarettes</span>
    </div>
    <p class="disclaimer">Based on PM2.5 exposure. You didn't choose this.</p>
  </div>

  <div class="stats">
    <div class="stat">
      <span class="stat-value">{pm25.toFixed(0)}</span>
      <span class="stat-label">µg/m³ PM2.5</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat">
      <span class="stat-value">{metrics.whoViolation.toFixed(0)}×</span>
      <span class="stat-label">WHO limit</span>
    </div>
    <div class="stat-divider"></div>
    <div class="stat danger">
      <span class="stat-value">{metrics.hoursLostEquivalentPerDay.toFixed(1)}</span>
      <span class="stat-label">hours of life lost today</span>
    </div>
  </div>

  <p class="source">Source: Berkeley Earth — 22 µg/m³ PM2.5 = 1 cigarette in mortality risk</p>
</section>

<style>
  .hero {
    background: #111;
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    color: #e5e5e5;
  }

  .hero-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  /* Cigarette illustration */
  .cigarette-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
    padding: 1.5rem 0;
  }

  .cigarette {
    width: min(280px, 70%);
    height: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.4));
  }

  /* Smoke animation */
  .smoke {
    position: absolute;
    right: calc(50% - 140px + 190px);
    top: 0;
    width: 40px;
    height: 60px;
    pointer-events: none;
  }

  .smoke-wisp {
    position: absolute;
    bottom: 20px;
    width: 8px;
    height: 8px;
    background: rgba(200, 200, 200, 0.6);
    border-radius: 50%;
    filter: blur(4px);
    animation: smoke-rise 3s ease-out infinite;
  }

  .wisp-1 {
    left: 10px;
    animation-delay: 0s;
  }

  .wisp-2 {
    left: 18px;
    animation-delay: 1s;
  }

  .wisp-3 {
    left: 26px;
    animation-delay: 2s;
  }

  @keyframes smoke-rise {
    0% {
      opacity: 0.7;
      transform: translateY(0) translateX(0) scale(1);
    }
    50% {
      opacity: 0.4;
      transform: translateY(-30px) translateX(8px) scale(1.5);
    }
    100% {
      opacity: 0;
      transform: translateY(-60px) translateX(-5px) scale(2);
    }
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #4ade80;
  }

  .live-badge::before {
    content: '';
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
  }

  .city-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #fff;
    margin: 0;
  }

  .main-message {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #333;
  }

  .intro {
    font-size: 1.125rem;
    color: #aaa;
    margin: 0 0 1rem 0;
  }

  .cigarette-count {
    margin-bottom: 1rem;
  }

  .count {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(3.5rem, 12vw, 5rem);
    font-weight: 400;
    color: #f87171;
    line-height: 1;
  }

  .unit {
    display: block;
    font-size: 1.25rem;
    color: #ccc;
    margin-top: 0.5rem;
  }

  .disclaimer {
    font-size: 0.9375rem;
    color: #888;
    margin: 0;
  }

  .stats {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stat {
    text-align: center;
    flex: 1;
    max-width: 150px;
  }

  .stat-divider {
    width: 1px;
    background: #333;
  }

  .stat-value {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 500;
    color: #fff;
    line-height: 1.2;
  }

  .stat.danger .stat-value {
    color: #f87171;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: #888;
    margin-top: 0.25rem;
    line-height: 1.3;
  }

  .source {
    font-size: 0.75rem;
    color: #666;
    text-align: center;
    margin: 0;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 1.5rem 1.25rem;
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      border-radius: 0;
    }

    .city-name {
      font-size: 1.25rem;
    }

    .stats {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .stat-divider {
      display: none;
    }

    .stat {
      min-width: 100px;
    }

    .stat-value {
      font-size: 1.5rem;
    }
  }
</style>
