---
/**
 * Risk Context Component — REFINED V3
 *
 * Who's at risk and what activities are dangerous.
 * Clean, refined cards with consistent spacing.
 */

interface Props {
  pm25: number;
  cityName: string;
}

const { pm25, cityName } = Astro.props;

// Risk status function
function getRiskStatus(pm25: number, threshold: number): 'safe' | 'caution' | 'avoid' | 'danger' {
  if (pm25 < threshold) return 'safe';
  if (pm25 < threshold * 1.5) return 'caution';
  if (pm25 < threshold * 2.5) return 'avoid';
  return 'danger';
}

// Risk groups
const riskGroups = [
  {
    group: 'Children',
    threshold: 12,
    status: getRiskStatus(pm25, 12),
    action: pm25 < 12 ? 'Outdoor play OK' : pm25 < 35 ? 'Limit outdoor time' : 'Keep indoors',
  },
  {
    group: 'Elderly',
    threshold: 15,
    status: getRiskStatus(pm25, 15),
    action: pm25 < 15 ? 'Normal activity' : pm25 < 35 ? 'Reduce exertion' : 'Stay inside',
  },
  {
    group: 'Pregnant',
    threshold: 12,
    status: getRiskStatus(pm25, 12),
    action: pm25 < 12 ? 'Normal activity' : pm25 < 25 ? 'Limit exposure' : 'Avoid outdoors',
  },
  {
    group: 'Asthmatics',
    threshold: 25,
    status: getRiskStatus(pm25, 25),
    action: pm25 < 25 ? 'Monitor symptoms' : pm25 < 50 ? 'Carry inhaler' : 'Emergency risk',
  },
  {
    group: 'Athletes',
    threshold: 35,
    status: getRiskStatus(pm25, 35),
    action: pm25 < 35 ? 'Outdoor sports OK' : pm25 < 55 ? 'Indoor gym only' : 'Skip workout',
  },
  {
    group: 'Outdoor Workers',
    threshold: 55,
    status: getRiskStatus(pm25, 55),
    action: pm25 < 55 ? 'Normal work' : pm25 < 150 ? 'Mask required' : 'Hazard pay?',
  },
];

// Count at-risk groups
const atRiskCount = riskGroups.filter(g => g.status !== 'safe').length;
const dangerCount = riskGroups.filter(g => g.status === 'danger').length;

// Activities
const activities = [
  {
    activity: 'Morning jog',
    safe: pm25 < 35,
    note: pm25 < 35 ? 'Acceptable' : pm25 < 55 ? 'Not recommended' : 'Lung damage',
  },
  {
    activity: 'Open windows',
    safe: pm25 < 25,
    note: pm25 < 25 ? 'Fresh air OK' : 'Keep sealed',
  },
  {
    activity: 'Outdoor dining',
    safe: pm25 < 50,
    note: pm25 < 50 ? 'Bon appétit' : 'Eat inside',
  },
  {
    activity: 'Kids playing',
    safe: pm25 < 35,
    note: pm25 < 35 ? 'Supervised OK' : 'Indoor play only',
  },
];

const statusColors = {
  safe: '#059669',
  caution: '#d97706',
  avoid: '#ea580c',
  danger: '#dc2626',
};
---

<section class="risk-context">
  <header class="section-header">
    <span class="header-label">Vulnerability Assessment</span>
    <h3 class="header-title">Who Should Stay Indoors</h3>
    <p class="header-kicker">Spoiler: probably you.</p>
  </header>

  <div class="risk-summary">
    <div class="summary-main">
      <span class="summary-number" style={`color: ${atRiskCount > 3 ? '#dc2626' : '#f97316'}`}>
        {atRiskCount}
      </span>
      <span class="summary-context">of {riskGroups.length} groups at risk</span>
    </div>
    {dangerCount > 0 && (
      <div class="danger-badge">
        {dangerCount} group{dangerCount > 1 ? 's' : ''} in danger zone
      </div>
    )}
  </div>

  <div class="risk-grid">
    {riskGroups.map((group) => (
      <article
        class:list={['risk-card', group.status]}
        style={`--status-color: ${statusColors[group.status]}`}
      >
        <div class="card-accent"></div>
        <div class="card-body">
          <div class="card-top">
            <span class="group-name">{group.group}</span>
            <span class="status-pill">{group.status}</span>
          </div>
          <p class="group-action">{group.action}</p>
        </div>
      </article>
    ))}
  </div>

  <div class="activities-section">
    <h4 class="activities-label">Activity Check</h4>
    <div class="activities-grid">
      {activities.map((act) => (
        <div class:list={['activity-item', { safe: act.safe, unsafe: !act.safe }]}>
          <span class="activity-name">{act.activity}</span>
          <span class="activity-status">{act.note}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .risk-context {
    background: var(--bg-elevated, #ffffff);
    border: 1px solid var(--border, #e2e0dd);
    border-radius: var(--radius-xl, 20px);
    padding: var(--space-8, 2rem);
    box-shadow: var(--shadow-sm, 0 2px 4px rgba(0, 0, 0, 0.04));
  }

  /* Header */
  .section-header {
    text-align: center;
    margin-bottom: var(--space-6, 1.5rem);
  }

  .header-label {
    display: block;
    font-size: var(--text-micro, 0.625rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-subtle, #8a8a8a);
    margin-bottom: var(--space-2, 0.5rem);
  }

  .header-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-h2, clamp(1.375rem, 3vw, 1.75rem));
    font-weight: 400;
    color: var(--text, #1a1a1a);
    margin: 0 0 var(--space-2, 0.5rem) 0;
    letter-spacing: -0.02em;
  }

  .header-kicker {
    font-size: var(--text-sm, 0.9375rem);
    font-style: italic;
    color: var(--text-muted, #6b6b6b);
    margin: 0;
  }

  /* Summary */
  .risk-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    margin-bottom: var(--space-6, 1.5rem);
    padding: var(--space-5, 1.25rem);
    background: var(--bg-sunken, #f0efed);
    border-radius: var(--radius-lg, 14px);
  }

  .summary-main {
    display: flex;
    align-items: baseline;
    gap: var(--space-2, 0.5rem);
  }

  .summary-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-display-md, 2.5rem);
    font-weight: 400;
    line-height: 1;
  }

  .summary-context {
    font-size: var(--text-base, 1rem);
    color: var(--text-muted, #6b6b6b);
  }

  .danger-badge {
    font-size: var(--text-caption, 0.6875rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #dc2626;
    background: rgba(220, 38, 38, 0.08);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border-radius: var(--radius-sm, 6px);
  }

  /* Risk Grid */
  .risk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3, 0.75rem);
    margin-bottom: var(--space-8, 2rem);
  }

  .risk-card {
    display: flex;
    background: var(--bg-sunken, #f0efed);
    border: 1px solid var(--border-subtle, #ebe9e6);
    border-radius: var(--radius-md, 10px);
    overflow: hidden;
    transition:
      transform var(--duration-fast, 150ms) var(--ease-out, ease),
      box-shadow var(--duration-fast, 150ms) var(--ease-out, ease);
  }

  .risk-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.06));
  }

  .risk-card.caution {
    background: rgba(217, 119, 6, 0.04);
    border-color: rgba(217, 119, 6, 0.15);
  }

  .risk-card.avoid {
    background: rgba(234, 88, 12, 0.04);
    border-color: rgba(234, 88, 12, 0.15);
  }

  .risk-card.danger {
    background: rgba(220, 38, 38, 0.04);
    border-color: rgba(220, 38, 38, 0.18);
  }

  .card-accent {
    width: 4px;
    background: var(--status-color);
    flex-shrink: 0;
  }

  .card-body {
    padding: var(--space-4, 1rem);
    flex: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2, 0.5rem);
  }

  .group-name {
    font-size: var(--text-sm, 0.9375rem);
    font-weight: 600;
    color: var(--text, #1a1a1a);
  }

  .status-pill {
    font-size: var(--text-micro, 0.625rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--status-color);
    background: color-mix(in srgb, var(--status-color) 10%, transparent);
    padding: 2px var(--space-2, 0.5rem);
    border-radius: var(--radius-sm, 6px);
  }

  .group-action {
    font-size: var(--text-xs, 0.8125rem);
    color: var(--text-secondary, #4a4a4a);
    margin: 0;
    line-height: 1.4;
  }

  /* Activities */
  .activities-section {
    padding-top: var(--space-6, 1.5rem);
    border-top: 1px solid var(--border, #e2e0dd);
  }

  .activities-label {
    font-size: var(--text-caption, 0.6875rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-subtle, #8a8a8a);
    margin: 0 0 var(--space-4, 1rem) 0;
    text-align: center;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2, 0.5rem);
  }

  .activity-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    border-radius: var(--radius-md, 10px);
    border: 1px solid;
  }

  .activity-item.safe {
    background: rgba(5, 150, 105, 0.04);
    border-color: rgba(5, 150, 105, 0.15);
  }

  .activity-item.unsafe {
    background: rgba(220, 38, 38, 0.04);
    border-color: rgba(220, 38, 38, 0.15);
  }

  .activity-name {
    font-size: var(--text-sm, 0.9375rem);
    font-weight: 500;
    color: var(--text, #1a1a1a);
  }

  .activity-status {
    font-size: var(--text-xs, 0.8125rem);
    color: var(--text-muted, #6b6b6b);
  }

  .activity-item.unsafe .activity-status {
    color: #dc2626;
    font-weight: 500;
  }

  .activity-item.safe .activity-status {
    color: #059669;
  }

  /* ═══════════════════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════════════════ */

  @media (max-width: 768px) {
    .risk-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .risk-context {
      padding: var(--space-6, 1.5rem) var(--space-5, 1.25rem);
    }

    .header-title {
      font-size: var(--text-h3, 1.25rem);
    }

    .risk-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2, 0.5rem);
    }

    .card-body {
      padding: var(--space-3, 0.75rem);
    }

    .activities-grid {
      grid-template-columns: 1fr;
    }

    .summary-number {
      font-size: var(--text-h1, 2rem);
    }
  }
</style>
