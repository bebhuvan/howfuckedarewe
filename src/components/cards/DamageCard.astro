---
/**
 * Damage Card Component — REFINED V3
 *
 * The arithmetic of breathing. Three time horizons.
 * TODAY. THIS YEAR. LIFETIME.
 *
 * Premium dark card with refined grid and impactful numbers.
 */
import type { AirQualityMetrics } from "../../lib/types";

interface Props {
  metrics: AirQualityMetrics;
}

const { metrics } = Astro.props;

// Calculate damage at different time scales
const yearsLost = metrics.yearsLost;
const monthsLost = yearsLost * 12;
const hoursLostToday =
  metrics.hoursLostEquivalentPerDay || (yearsLost * 365 * 24) / 365;
const daysLostPerYear = (hoursLostToday * 365) / 24;

// Cigarettes are visceral
const cigsPerDay = metrics.cigarettesPerDay;
const cigsPerYear = cigsPerDay * 365;
const packsPerYear = cigsPerYear / 20;
---

<section class="damage-card">
  <!-- Accent line -->
  <div class="accent-line" aria-hidden="true"></div>

  <header class="card-header">
    <span class="header-label">The Arithmetic</span>
    <h3 class="header-title">What You're Losing</h3>
  </header>

  <div class="damage-grid">
    <!-- TODAY -->
    <article class="damage-cell">
      <div class="cell-badge today">Today</div>
      <div class="cell-primary">
        <span class="primary-number">{cigsPerDay.toFixed(1)}</span>
        <span class="primary-unit">cigarettes</span>
      </div>
      <div class="cell-secondary">
        <svg class="secondary-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12,6 12,12 16,14"/>
        </svg>
        <span class="secondary-text">{hoursLostToday.toFixed(1)} hours of life</span>
      </div>
      <p class="cell-kicker">Just by existing.</p>
    </article>

    <!-- THIS YEAR -->
    <article class="damage-cell">
      <div class="cell-badge year">This Year</div>
      <div class="cell-primary">
        <span class="primary-number">{packsPerYear.toFixed(0)}</span>
        <span class="primary-unit">packs</span>
      </div>
      <div class="cell-secondary">
        <svg class="secondary-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        <span class="secondary-text">{daysLostPerYear.toFixed(1)} days gone</span>
      </div>
      <p class="cell-kicker">A vacation you'll never take.</p>
    </article>

    <!-- LIFETIME -->
    <article class="damage-cell lifetime">
      <div class="cell-badge lifetime-badge">Lifetime</div>
      <div class="cell-primary">
        <span class="primary-number">
          {monthsLost >= 12 ? yearsLost.toFixed(1) : monthsLost.toFixed(0)}
        </span>
        <span class="primary-unit">{monthsLost >= 12 ? "years" : "months"}</span>
      </div>
      <div class="lifetime-statement">
        {
          yearsLost >= 2
            ? `${yearsLost.toFixed(0)} birthdays you won't see.`
            : monthsLost >= 6
              ? `Half a year. Gone.`
              : `It adds up.`
        }
      </div>
      <p class="cell-kicker">If you breathe this your whole life. Which will be shorter.</p>
    </article>
  </div>

  <footer class="card-footer">
    <p class="footer-text">
      Peer-reviewed calculations from Berkeley Earth and AQLI.
      <a href="/methodology">See methodology →</a>
    </p>
  </footer>
</section>

<style>
  .damage-card {
    position: relative;
    background: linear-gradient(180deg, #0f0f0f 0%, #0a0a0a 100%);
    border-radius: var(--radius-2xl, 28px);
    padding: var(--space-10, 2.5rem) var(--space-8, 2rem);
    margin-bottom: var(--space-8, 2rem);
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 16px 32px -8px rgba(0, 0, 0, 0.4);
  }

  /* Accent line */
  .accent-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #eab308 0%, #f97316 50%, #ef4444 100%);
  }

  /* Header */
  .card-header {
    text-align: center;
    margin-bottom: var(--space-10, 2.5rem);
  }

  .header-label {
    display: block;
    font-size: var(--text-caption, 0.6875rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.35);
    margin-bottom: var(--space-2, 0.5rem);
  }

  .header-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-h1, clamp(1.75rem, 4vw, 2.25rem));
    font-weight: 400;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Grid */
  .damage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg, 14px);
    overflow: hidden;
    margin-bottom: var(--space-8, 2rem);
  }

  /* Cell */
  .damage-cell {
    background: #0a0a0a;
    padding: var(--space-8, 2rem) var(--space-6, 1.5rem);
    text-align: center;
    display: flex;
    flex-direction: column;
  }

  .damage-cell.lifetime {
    background: linear-gradient(180deg, rgba(239, 68, 68, 0.06) 0%, rgba(239, 68, 68, 0.02) 100%);
  }

  /* Badge */
  .cell-badge {
    display: inline-block;
    font-size: var(--text-micro, 0.625rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border-radius: var(--radius-full, 9999px);
    margin: 0 auto var(--space-5, 1.25rem);
    width: fit-content;
  }

  .cell-badge.today {
    background: rgba(234, 179, 8, 0.12);
    color: #fbbf24;
  }

  .cell-badge.year {
    background: rgba(249, 115, 22, 0.12);
    color: #fb923c;
  }

  .cell-badge.lifetime-badge {
    background: rgba(239, 68, 68, 0.12);
    color: #f87171;
  }

  /* Primary stat */
  .cell-primary {
    margin-bottom: var(--space-5, 1.25rem);
  }

  .primary-number {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-display-md, clamp(2.5rem, 7vw, 3.5rem));
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .damage-cell:first-child .primary-number {
    color: #fbbf24;
  }

  .damage-cell:nth-child(2) .primary-number {
    color: #fb923c;
  }

  .damage-cell.lifetime .primary-number {
    color: #f87171;
  }

  .primary-unit {
    display: block;
    font-size: var(--text-base, 1rem);
    color: rgba(255, 255, 255, 0.6);
    margin-top: var(--space-1, 0.25rem);
  }

  /* Secondary stat */
  .cell-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius-md, 10px);
    margin-bottom: var(--space-4, 1rem);
  }

  .secondary-icon {
    color: rgba(255, 255, 255, 0.4);
    flex-shrink: 0;
  }

  .secondary-text {
    font-size: var(--text-sm, 0.9375rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Lifetime statement */
  .lifetime-statement {
    font-size: var(--text-lg, 1.125rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: rgba(239, 68, 68, 0.08);
    border-radius: var(--radius-md, 10px);
    margin-bottom: var(--space-4, 1rem);
  }

  /* Kicker */
  .cell-kicker {
    font-size: var(--text-xs, 0.8125rem);
    font-style: italic;
    color: rgba(255, 255, 255, 0.35);
    margin: auto 0 0 0;
    line-height: 1.45;
  }

  /* Footer */
  .card-footer {
    text-align: center;
    padding-top: var(--space-6, 1.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-text {
    font-size: var(--text-sm, 0.9375rem);
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
  }

  .footer-text a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    margin-left: var(--space-1, 0.25rem);
    transition: color 0.2s ease;
  }

  .footer-text a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* ═══════════════════════════════════════════════════════════════
     TABLET
     ═══════════════════════════════════════════════════════════════ */

  @media (min-width: 600px) and (max-width: 899px) {
    .damage-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .damage-cell.lifetime {
      grid-column: 1 / -1;
    }

    .primary-number {
      font-size: clamp(2.25rem, 6vw, 3rem);
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     MOBILE
     ═══════════════════════════════════════════════════════════════ */

  @media (max-width: 599px) {
    .damage-card {
      padding: var(--space-8, 2rem) var(--space-5, 1.25rem);
      margin-left: calc(-1 * var(--space-5, 1.25rem));
      margin-right: calc(-1 * var(--space-5, 1.25rem));
      border-radius: 0;
    }

    .card-header {
      margin-bottom: var(--space-8, 2rem);
    }

    .header-title {
      font-size: var(--text-h2, 1.5rem);
    }

    .damage-grid {
      grid-template-columns: 1fr;
      border-radius: var(--radius-md, 10px);
    }

    .damage-cell {
      padding: var(--space-6, 1.5rem) var(--space-5, 1.25rem);
    }

    .cell-badge {
      margin-bottom: var(--space-4, 1rem);
    }

    .cell-primary {
      margin-bottom: var(--space-4, 1rem);
    }

    .primary-number {
      font-size: clamp(2.5rem, 12vw, 3rem);
    }
  }
</style>
