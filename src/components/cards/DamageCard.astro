---
/**
 * Damage Card — Human-friendly V5
 *
 * Light card. Simple language. Real-world comparisons.
 */
import type { AirQualityMetrics } from "../../lib/types";

interface Props {
  metrics: AirQualityMetrics;
}

const { metrics } = Astro.props;

const yearsLost = metrics.yearsLost;
const monthsLost = yearsLost * 12;
const weeksLost = yearsLost * 52;
const hoursLostToday = metrics.hoursLostEquivalentPerDay || (yearsLost * 365 * 24) / 365;
const daysLostPerYear = (hoursLostToday * 365) / 24;

// Human-friendly comparisons
function getLifetimeComparison(years: number): string {
  if (years >= 5) return `That's a child growing from birth to kindergarten.`;
  if (years >= 2) return `That's longer than most people date before marriage.`;
  if (years >= 1) return `That's an entire year of sunrises you'll never see.`;
  if (monthsLost >= 6) return `That's a whole summer and winter, gone.`;
  return `Every day adds up.`;
}
---

<section class="damage-card">
  <header class="card-header">
    <h3 class="header-title">The Cost of Breathing Here</h3>
    <p class="header-sub">If you live here long-term, this is what the air takes from you.</p>
  </header>

  <div class="damage-list">
    <div class="damage-item">
      <div class="item-icon today-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12,6 12,12 16,14"/>
        </svg>
      </div>
      <div class="item-content">
        <span class="item-label">Every single day</span>
        <p class="item-main">
          You lose <strong class="highlight-amber">{hoursLostToday.toFixed(1)} hours</strong> of your life
        </p>
        <p class="item-note">Just by breathing. Not smoking, not drinking. Just existing here.</p>
      </div>
    </div>

    <div class="damage-item">
      <div class="item-icon year-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <div class="item-content">
        <span class="item-label">Every year</span>
        <p class="item-main">
          You lose <strong class="highlight-orange">{daysLostPerYear.toFixed(0)} days</strong> of your life
        </p>
        <p class="item-note">That's {(daysLostPerYear / 7).toFixed(0)} weeks. A vacation you'll never take.</p>
      </div>
    </div>

    <div class="damage-item featured">
      <div class="item-icon lifetime-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <div class="item-content">
        <span class="item-label">Over your lifetime</span>
        <p class="item-main">
          You lose <strong class="highlight-red">{monthsLost >= 12 ? yearsLost.toFixed(1) + ' years' : monthsLost.toFixed(0) + ' months'}</strong>
        </p>
        <p class="item-note">{getLifetimeComparison(yearsLost)}</p>
      </div>
    </div>
  </div>

  <footer class="card-footer">
    <p class="footer-note">
      These numbers come from peer-reviewed research by Berkeley Earth and the Air Quality Life Index.
      <a href="/methodology">How we calculate this →</a>
    </p>
  </footer>
</section>

<style>
  .damage-card {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
  }

  .card-header {
    margin-bottom: 1.5rem;
  }

  .header-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: #1a1a1a;
    margin: 0 0 0.5rem 0;
  }

  .header-sub {
    font-size: 1rem;
    color: #666;
    margin: 0;
    line-height: 1.5;
  }

  .damage-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .damage-item {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: #fafafa;
    border-radius: 12px;
    border: 1px solid #eee;
  }

  .damage-item.featured {
    background: #fef2f2;
    border-color: #fecaca;
  }

  .item-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
  }

  .today-icon {
    background: #fef3c7;
    color: #d97706;
  }

  .year-icon {
    background: #ffedd5;
    color: #ea580c;
  }

  .lifetime-icon {
    background: #fee2e2;
    color: #dc2626;
  }

  .item-content {
    flex: 1;
  }

  .item-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #888;
    margin-bottom: 0.25rem;
  }

  .item-main {
    font-size: 1.125rem;
    color: #1a1a1a;
    margin: 0 0 0.25rem 0;
    line-height: 1.4;
  }

  .item-main strong {
    font-weight: 600;
  }

  .highlight-amber { color: #d97706; }
  .highlight-orange { color: #ea580c; }
  .highlight-red { color: #dc2626; }

  .item-note {
    font-size: 0.9375rem;
    color: #666;
    margin: 0;
    line-height: 1.4;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid #eee;
  }

  .footer-note {
    font-size: 0.8125rem;
    color: #888;
    margin: 0;
    line-height: 1.5;
  }

  .footer-note a {
    color: #666;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-note a:hover {
    color: #1a1a1a;
  }

  @media (max-width: 600px) {
    .damage-card {
      padding: 1.5rem 1.25rem;
    }

    .header-title {
      font-size: 1.25rem;
    }

    .damage-item {
      padding: 1rem;
    }

    .item-icon {
      width: 40px;
      height: 40px;
    }

    .item-main {
      font-size: 1rem;
    }
  }
</style>
