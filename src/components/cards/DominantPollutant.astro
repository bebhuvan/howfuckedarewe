---
/**
 * Dominant Pollutant Component — REDESIGNED
 *
 * "Today's Villain" - highlights what's driving the AQI.
 * Clean, elegant, no emojis.
 */

interface Props {
  pollutant: string | null;
  cityName: string;
}

const { pollutant, cityName } = Astro.props;

interface PollutantMeta {
  name: string;
  fullName: string;
  sources: string;
  harm: string;
  color: string;
}

const pollutantData: Record<string, PollutantMeta> = {
  pm25: {
    name: 'PM2.5',
    fullName: 'Fine Particulate Matter',
    sources: 'Vehicle exhaust, construction dust, burning, industrial emissions',
    harm: 'Enters bloodstream, reaches brain and heart, causes cancer',
    color: '#dc2626',
  },
  pm10: {
    name: 'PM10',
    fullName: 'Coarse Particles',
    sources: 'Road dust, construction activities, pollen',
    harm: 'Lodges in lungs, triggers asthma, respiratory infections',
    color: '#ea580c',
  },
  o3: {
    name: 'O₃',
    fullName: 'Ground-Level Ozone',
    sources: 'Sunlight reacting with vehicle and industrial emissions',
    harm: 'Burns lung tissue, worsens asthma, reduces lung function',
    color: '#ca8a04',
  },
  no2: {
    name: 'NO₂',
    fullName: 'Nitrogen Dioxide',
    sources: 'Vehicle exhaust, power plants',
    harm: 'Inflames airways, increases infection risk, triggers asthma',
    color: '#c2410c',
  },
  so2: {
    name: 'SO₂',
    fullName: 'Sulfur Dioxide',
    sources: 'Coal burning, refineries, smelters',
    harm: 'Irritates throat and lungs, worsens heart disease',
    color: '#7c3aed',
  },
  co: {
    name: 'CO',
    fullName: 'Carbon Monoxide',
    sources: 'Incomplete combustion, vehicles, fires',
    harm: 'Displaces oxygen in blood, damages heart and brain',
    color: '#64748b',
  },
};

const normalizedKey = pollutant?.toLowerCase().replace('2', '25').replace('₂', '2') || 'pm25';
const meta = pollutantData[normalizedKey] || pollutantData.pm25;

const hour = new Date().getHours();
function getTimeContext(): string {
  if (hour >= 7 && hour <= 10) return "Peak morning traffic hours.";
  if (hour >= 17 && hour <= 20) return "Evening rush hour and cooking.";
  if (hour >= 22 || hour <= 5) return "Overnight inversions trap pollutants.";
  return "Multiple sources active.";
}
---

{pollutant && (
  <section class="pollutant-card" style={`--accent: ${meta.color}`}>
    <div class="card-layout">
      <div class="pollutant-badge">
        <span class="badge-eyebrow">Primary Pollutant</span>
        <span class="badge-symbol">{meta.name}</span>
        <span class="badge-full">{meta.fullName}</span>
      </div>

      <div class="pollutant-info">
        <div class="info-row">
          <div class="info-item">
            <span class="info-label">Sources</span>
            <p class="info-text">{meta.sources}</p>
          </div>
          <div class="info-item harm">
            <span class="info-label">Health Impact</span>
            <p class="info-text">{meta.harm}</p>
          </div>
        </div>
        <p class="time-note">{getTimeContext()}</p>
      </div>
    </div>
  </section>
)}

<style>
  .pollutant-card {
    background: white;
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .card-layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .pollutant-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-radius: 12px;
    min-width: 120px;
    text-align: center;
  }

  .badge-eyebrow {
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .badge-symbol {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 500;
    color: var(--accent);
    line-height: 1.1;
    margin-bottom: 0.25rem;
  }

  .badge-full {
    font-size: 0.6875rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  .pollutant-info {
    padding-top: 0.25rem;
  }

  .info-row {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .info-item {
    display: flex;
    flex-direction: column;
  }

  .info-label {
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
    margin-bottom: 0.25rem;
  }

  .info-text {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .info-item.harm .info-text {
    color: var(--accent);
    font-weight: 500;
  }

  .time-note {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--text-light);
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 600px) {
    .card-layout {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .pollutant-badge {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      text-align: left;
    }

    .badge-eyebrow {
      display: none;
    }

    .badge-symbol {
      font-size: 1.5rem;
      margin-bottom: 0;
    }

    .badge-full {
      font-size: 0.75rem;
    }

    .info-row {
      gap: 0.75rem;
    }
  }
</style>
