---
/**
 * Live Pollutant Cocktail Component — REDESIGNED V2
 *
 * The toxic inventory. What's in your air right now.
 * Clean grid, color-coded severity, punchy health impacts.
 */

import type { PollutantReadings } from '../../lib/types';

interface Props {
  pollutants: PollutantReadings;
  dominantPollutant: string | null;
}

const { pollutants, dominantPollutant } = Astro.props;

// Pollutant metadata with short, punchy harm descriptions
const pollutantMeta: Record<string, { name: string; fullName: string; harm: string; color: string }> = {
  pm25: {
    name: 'PM2.5',
    fullName: 'Fine Particulate Matter',
    harm: 'Enters bloodstream. Reaches brain.',
    color: '#dc2626',
  },
  pm10: {
    name: 'PM10',
    fullName: 'Coarse Particles',
    harm: 'Lodges in lungs. Triggers asthma.',
    color: '#ea580c',
  },
  o3: {
    name: 'O₃',
    fullName: 'Ground-Level Ozone',
    harm: 'Burns lung tissue. Silently.',
    color: '#7c3aed',
  },
  no2: {
    name: 'NO₂',
    fullName: 'Nitrogen Dioxide',
    harm: 'Inflames airways. From traffic.',
    color: '#0891b2',
  },
  so2: {
    name: 'SO₂',
    fullName: 'Sulfur Dioxide',
    harm: 'Acid rain precursor. In you.',
    color: '#ca8a04',
  },
  co: {
    name: 'CO',
    fullName: 'Carbon Monoxide',
    harm: 'Displaces oxygen. Invisibly.',
    color: '#64748b',
  },
};

// Severity thresholds
function getSeverity(aqi: number): { level: string; label: string; bgColor: string } {
  if (aqi <= 50) return { level: 'good', label: 'Good', bgColor: 'rgba(34, 197, 94, 0.1)' };
  if (aqi <= 100) return { level: 'moderate', label: 'Moderate', bgColor: 'rgba(234, 179, 8, 0.1)' };
  if (aqi <= 150) return { level: 'unhealthy', label: 'Unhealthy', bgColor: 'rgba(249, 115, 22, 0.15)' };
  if (aqi <= 200) return { level: 'very-unhealthy', label: 'Very Unhealthy', bgColor: 'rgba(220, 38, 38, 0.15)' };
  return { level: 'hazardous', label: 'Hazardous', bgColor: 'rgba(127, 29, 29, 0.2)' };
}

// Build display list
type PollutantKey = keyof PollutantReadings;
const keys: PollutantKey[] = ['pm25', 'pm10', 'o3', 'no2', 'so2', 'co'];
const activePollutants = keys
  .filter((key) => pollutants[key] !== null)
  .map((key) => ({
    key,
    value: pollutants[key] as number,
    meta: pollutantMeta[key],
    severity: getSeverity(pollutants[key] as number),
    isDominant: dominantPollutant?.toLowerCase() === key ||
                dominantPollutant?.toLowerCase().replace('2', '₂').replace('3', '₃') === pollutantMeta[key].name.toLowerCase(),
  }));

// Sort: dominant first, then by value descending
activePollutants.sort((a, b) => {
  if (a.isDominant && !b.isDominant) return -1;
  if (!a.isDominant && b.isDominant) return 1;
  return b.value - a.value;
});

// Count harmful
const harmfulCount = activePollutants.filter(p => p.value > 100).length;
const elevatedCount = activePollutants.filter(p => p.value > 50 && p.value <= 100).length;
---

<section class="pollutant-cocktail">
  <header class="section-header">
    <span class="header-eyebrow">Air Composition</span>
    <h2 class="header-title">What's In Your Lungs Right Now</h2>
    <p class="header-summary">
      {harmfulCount > 0 ? (
        <span class="summary-danger">{harmfulCount} pollutant{harmfulCount > 1 ? 's' : ''} at harmful levels.</span>
      ) : elevatedCount > 0 ? (
        <span class="summary-warning">{elevatedCount} elevated. Not crisis. Not safe.</span>
      ) : (
        <span class="summary-ok">All within limits. For now.</span>
      )}
    </p>
  </header>

  {activePollutants.length > 0 ? (
    <div class="pollutant-grid">
      {activePollutants.map((p) => (
        <div
          class:list={['pollutant-card', p.severity.level, { dominant: p.isDominant }]}
          style={`--accent-color: ${p.meta.color}; --bg-tint: ${p.severity.bgColor}`}
        >
          {p.isDominant && (
            <div class="dominant-tag">Primary Threat</div>
          )}

          <div class="card-top">
            <div class="pollutant-id">
              <span class="pollutant-symbol">{p.meta.name}</span>
              <span class="pollutant-full">{p.meta.fullName}</span>
            </div>
            <div class="aqi-display">
              <span class="aqi-value">{p.value}</span>
              <span class="aqi-label">AQI</span>
            </div>
          </div>

          <div class="severity-row">
            <div class="severity-bar">
              <div
                class="severity-fill"
                style={`width: ${Math.min((p.value / 200) * 100, 100)}%`}
              ></div>
            </div>
            <span class="severity-label">{p.severity.label}</span>
          </div>

          <p class="harm-text">{p.meta.harm}</p>
        </div>
      ))}
    </div>
  ) : (
    <div class="no-data">
      <p>No live pollutant data available.</p>
      <p class="no-data-note">The sensors may be offline. Or just giving up.</p>
    </div>
  )}

  <footer class="section-footer">
    <div class="legend">
      <div class="legend-item">
        <span class="legend-dot" style="background: #22c55e"></span>
        <span>0-50 Good</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style="background: #eab308"></span>
        <span>51-100 Moderate</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style="background: #f97316"></span>
        <span>101-150 Unhealthy</span>
      </div>
      <div class="legend-item">
        <span class="legend-dot" style="background: #dc2626"></span>
        <span>151+ Hazardous</span>
      </div>
    </div>
  </footer>
</section>

<style>
  .pollutant-cocktail {
    background: white;
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    margin-bottom: 2rem;
  }

  /* Header */
  .section-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .header-eyebrow {
    display: block;
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-light);
    margin-bottom: 0.5rem;
  }

  .header-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text);
    margin: 0 0 0.75rem 0;
  }

  .header-summary {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  .summary-danger {
    color: #dc2626;
    font-weight: 600;
  }

  .summary-warning {
    color: #ca8a04;
  }

  .summary-ok {
    color: #16a34a;
  }

  /* Grid */
  .pollutant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  /* Cards */
  .pollutant-card {
    position: relative;
    background: var(--bg-tint, #fafafa);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent-color, var(--text-light));
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pollutant-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .pollutant-card.dominant {
    border-left-width: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .dominant-tag {
    position: absolute;
    top: -10px;
    right: 1rem;
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.625rem;
    background: var(--accent-color);
    color: white;
    border-radius: 4px;
  }

  /* Card Top */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
  }

  .pollutant-id {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .pollutant-symbol {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--accent-color);
    line-height: 1;
  }

  .pollutant-full {
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .aqi-display {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .aqi-value {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1;
    color: var(--text);
  }

  .aqi-label {
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-light);
  }

  /* Severity Row */
  .severity-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .severity-bar {
    flex: 1;
    height: 6px;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .severity-fill {
    height: 100%;
    background: var(--accent-color);
    border-radius: 3px;
    transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .severity-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--accent-color);
    white-space: nowrap;
  }

  /* Harm Text */
  .harm-text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.4;
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    font-style: italic;
  }

  /* No Data */
  .no-data {
    text-align: center;
    padding: 3rem 2rem;
    background: #fafafa;
    border-radius: 12px;
  }

  .no-data p {
    margin: 0;
    color: var(--text-muted);
  }

  .no-data-note {
    font-size: 0.875rem;
    font-style: italic;
    margin-top: 0.5rem !important;
    color: var(--text-light) !important;
  }

  /* Footer */
  .section-footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .legend {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  /* Mobile */
  @media (max-width: 600px) {
    .pollutant-cocktail {
      padding: 1.5rem 1.25rem;
    }

    .header-title {
      font-size: 1.5rem;
    }

    .pollutant-grid {
      grid-template-columns: 1fr;
    }

    .pollutant-card {
      padding: 1.25rem;
    }

    .card-top {
      flex-direction: row;
      align-items: center;
    }

    .aqi-value {
      font-size: 2rem;
    }

    .legend {
      gap: 0.75rem 1.25rem;
    }
  }
</style>
