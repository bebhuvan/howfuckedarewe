---
/**
 * The Fucked Index™ — READABLE V4
 *
 * Clear, readable, no BS. Data you can actually understand.
 */
import type { AirQualityMetrics } from "../../lib/types";
import { WHO, US_EPA, INDIA_NAAQS } from "../../lib/constants";

interface Props {
  metrics: AirQualityMetrics;
  cityName: string;
  pm25?: number;
}

const { metrics, cityName, pm25 } = Astro.props;
const actualPm25 = pm25 ?? metrics.whoViolation * WHO.PM25_ANNUAL;

const whoFucked = actualPm25 / WHO.PM25_ANNUAL;
const epaFucked = actualPm25 / US_EPA.PM25_ANNUAL;
const indiaFucked = actualPm25 / INDIA_NAAQS.PM25_ANNUAL;

function getVerdict(whoRatio: number): { label: string; subtext: string; color: string } {
  if (whoRatio <= 1)
    return {
      label: "Within Safe Limits",
      subtext: "Rare for Indian cities. Enjoy it.",
      color: "#22c55e",
    };
  if (whoRatio <= 2)
    return {
      label: "Mildly Polluted",
      subtext: "Sensitive groups should limit outdoor time.",
      color: "#84cc16",
    };
  if (whoRatio <= 4)
    return {
      label: "Unhealthy",
      subtext: "Everyone should reduce prolonged outdoor exertion.",
      color: "#eab308",
    };
  if (whoRatio <= 8)
    return {
      label: "Very Unhealthy",
      subtext: "Avoid outdoor activities. Use air purifiers indoors.",
      color: "#f97316",
    };
  if (whoRatio <= 15)
    return {
      label: "Hazardous",
      subtext: "Health emergency. Stay indoors with windows closed.",
      color: "#ef4444",
    };
  return {
    label: "Severe",
    subtext: "Extremely dangerous. Avoid all outdoor exposure.",
    color: "#dc2626",
  };
}

const verdict = getVerdict(whoFucked);
---

<section class="fucked-index">
  <header class="header">
    <span class="label">Air Quality Index</span>
    <h2 class="title">The Fucked Index™</h2>
  </header>

  <div class="main-stat">
    <div class="number" style={`color: ${verdict.color}`}>
      {whoFucked.toFixed(1)}<span class="suffix">×</span>
    </div>
    <p class="context">above WHO safe limit</p>
  </div>

  <div class="verdict" style={`border-color: ${verdict.color}`}>
    <span class="verdict-label" style={`color: ${verdict.color}`}>{verdict.label}</span>
    <p class="verdict-text">{verdict.subtext}</p>
  </div>

  <div class="scale">
    <div class="scale-header">
      <span>Safe</span>
      <span>Hazardous</span>
    </div>
    <div class="scale-bar">
      <div class="scale-fill" style={`width: ${Math.min((whoFucked / 20) * 100, 100)}%`}></div>
      <div class="scale-marker" style={`left: ${Math.min((whoFucked / 20) * 100, 98)}%`}>
        <span class="marker-dot"></span>
      </div>
    </div>
    <div class="scale-labels">
      <span>1×</span>
      <span>5×</span>
      <span>10×</span>
      <span>15×</span>
      <span>20×</span>
    </div>
  </div>

  <div class="comparisons">
    <h3 class="comparisons-title">How {cityName} compares to safety standards</h3>

    <div class="comparison">
      <div class="comp-label">
        <strong>WHO</strong>
        <span class="comp-limit">5 µg/m³ annual limit</span>
      </div>
      <div class="comp-bar-wrap">
        <div class="comp-bar" style={`width: ${Math.min(whoFucked * 5, 100)}%; background: ${verdict.color}`}></div>
      </div>
      <span class="comp-value" style={`color: ${verdict.color}`}>{whoFucked.toFixed(1)}×</span>
    </div>

    <div class="comparison">
      <div class="comp-label">
        <strong>US EPA</strong>
        <span class="comp-limit">9 µg/m³ annual limit</span>
      </div>
      <div class="comp-bar-wrap">
        <div class="comp-bar" style={`width: ${Math.min(epaFucked * 10, 100)}%; background: #f97316`}></div>
      </div>
      <span class="comp-value">{epaFucked.toFixed(1)}×</span>
    </div>

    <div class="comparison">
      <div class="comp-label">
        <strong>India</strong>
        <span class="comp-limit">40 µg/m³ annual limit</span>
      </div>
      <div class="comp-bar-wrap">
        <div class="comp-bar" style={`width: ${Math.min(indiaFucked * 25, 100)}%; background: #eab308`}></div>
      </div>
      <span class="comp-value">{indiaFucked.toFixed(1)}×</span>
    </div>

    <p class="note">
      India's limit is 8× higher than WHO's recommendation.
      {indiaFucked > 1 ? ` ${cityName} fails even this lenient standard.` : ''}
    </p>
  </div>
</section>

<style>
  .fucked-index {
    background: #111;
    border-radius: 16px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    color: #e5e5e5;
  }

  .header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.75rem;
    font-weight: 500;
    color: #fff;
    margin: 0;
  }

  .main-stat {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .suffix {
    font-size: 0.4em;
    opacity: 0.8;
  }

  .context {
    font-size: 1.125rem;
    color: #aaa;
    margin: 0.5rem 0 0 0;
  }

  .verdict {
    text-align: center;
    padding: 1.25rem;
    border: 2px solid;
    border-radius: 12px;
    margin-bottom: 2rem;
    background: rgba(255, 255, 255, 0.02);
  }

  .verdict-label {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .verdict-text {
    font-size: 1rem;
    color: #ccc;
    margin: 0;
    line-height: 1.5;
  }

  .scale {
    margin-bottom: 2rem;
  }

  .scale-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .scale-bar {
    position: relative;
    height: 8px;
    background: linear-gradient(90deg, #22c55e 0%, #eab308 30%, #f97316 60%, #ef4444 80%, #7f1d1d 100%);
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }

  .scale-fill {
    display: none;
  }

  .scale-marker {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .marker-dot {
    display: block;
    width: 16px;
    height: 16px;
    background: #fff;
    border: 3px solid #111;
    border-radius: 50%;
  }

  .scale-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #666;
  }

  .comparisons {
    border-top: 1px solid #333;
    padding-top: 1.5rem;
  }

  .comparisons-title {
    font-size: 1rem;
    font-weight: 500;
    color: #ccc;
    margin: 0 0 1.25rem 0;
    font-family: inherit;
  }

  .comparison {
    display: grid;
    grid-template-columns: 100px 1fr 50px;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .comp-label {
    display: flex;
    flex-direction: column;
  }

  .comp-label strong {
    font-size: 0.9375rem;
    color: #e5e5e5;
  }

  .comp-limit {
    font-size: 0.75rem;
    color: #777;
  }

  .comp-bar-wrap {
    height: 8px;
    background: #333;
    border-radius: 4px;
    overflow: hidden;
  }

  .comp-bar {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
  }

  .comp-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.25rem;
    font-weight: 500;
    color: #e5e5e5;
    text-align: right;
  }

  .note {
    font-size: 0.875rem;
    color: #888;
    margin: 1.5rem 0 0 0;
    padding-top: 1rem;
    border-top: 1px solid #222;
    line-height: 1.6;
  }

  @media (max-width: 600px) {
    .fucked-index {
      padding: 1.5rem 1.25rem;
      margin-left: -1.25rem;
      margin-right: -1.25rem;
      border-radius: 0;
    }

    .number {
      font-size: clamp(3.5rem, 18vw, 5rem);
    }

    .comparison {
      grid-template-columns: 80px 1fr 45px;
      gap: 0.75rem;
    }

    .comp-value {
      font-size: 1rem;
    }
  }
</style>
